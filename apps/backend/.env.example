# ─── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/cecj_db"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change_me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=3001
# development (local) | production
NODE_ENV=development

# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS="http://localhost:3000"

# ─── Fichiers uploadés ────────────────────────────────────────────────────────
# URL publique servant /api/v1/uploads/*. OPTIONNEL : par défaut, le code choisit
# selon NODE_ENV (production → domaine public, sinon → http://localhost:<PORT>).
# Décommenter pour forcer une origine explicite.
# BACKEND_URL="https://api.campdejesusbelairfizi.com"

# Racine publique et temporaire des médias audio. En production, MEDIA_ROOT
# doit correspondre exactement au `root` du file_server Caddy.
# MEDIA_ROOT="/var/lib/cecj/media"
# MEDIA_TEMP_ROOT="/var/lib/cecj/.cecj-media-tmp"
# MEDIA_BASE_URL="https://api.campdejesusbelairfizi.com"
# FFPROBE_PATH="/usr/bin/ffprobe"
# FFMPEG_PATH="/usr/bin/ffmpeg"

# 45 min pour recevoir une requête complète ; reste borné contre les slowloris.
UPLOAD_REQUEST_TIMEOUT_MS=2700000
# Doit être supérieur au keepalive upstream Caddy (60 s dans l'exemple).
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000

# Domaines autorisés pour les flux radio publics et leur test SSRF-safe.
# Les sous-domaines sont acceptés (ex. foo.zeno.fm).
RADIO_STREAM_ALLOWED_HOSTS="stream.zeno.fm,zeno.fm"
