api.campdejesusbelairfizi.com {
    encode zstd gzip

    # Un upload validé mais pas encore rattaché à un enseignement reste privé.
    handle /media/audio/staged/* {
        respond 404
    }

    handle_path /media/* {
        root * /var/lib/cecj/media
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Multer limite le fichier à 500 MiB et renvoie une réponse JSON 413.
    # Pas de request_body ici : cette directive exige Caddy >= 2.10. Le proxy
    # streame nativement le multipart vers Node sans le charger en mémoire.

    reverse_proxy 127.0.0.1:3001 {
        transport http {
            # Inférieur au keepAliveTimeout Node (65 s) pour éviter les 502
            # "connection reset by peer" sur les POST non idempotents.
            keepalive 60s
        }
    }
}
